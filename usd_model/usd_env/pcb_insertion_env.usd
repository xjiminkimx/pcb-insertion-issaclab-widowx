#usda 1.0
(
    defaultPrim = "PCB_Env"
    doc = "PCB Insertion Environment - magazine + guide rails (kinematic fixture)"
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Z"
)

def Xform "PCB_Env" (
    kind = "component"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = true

    def Scope "Looks"
    {
        def Material "MagazineMaterial"
        {
            token outputs:surface.connect = </PCB_Env/Looks/MagazineMaterial/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.615686, 0.811765, 0.929412)
                float inputs:roughness = 0.550
                float inputs:metallic = 0.050
                token outputs:surface
            }
        }

        def Material "RailMaterial"
        {
            token outputs:surface.connect = </PCB_Env/Looks/RailMaterial/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.720000, 0.720000, 0.750000)
                float inputs:roughness = 0.300
                float inputs:metallic = 0.850
                token outputs:surface
            }
        }

    }

